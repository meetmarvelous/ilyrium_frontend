# Server Port
PORT=8080

# Redis Cache URL (used for rate-limiting and active API key validation)
REDIS_URL=localhost:6379

# Primary Solana RPC Provider (e.g. Helius, QuickNode)
PRIMARY_RPC_URL=https://api.devnet.solana.com

# Fallback Solana RPC Provider (used automatically if primary fails/times out)
FALLBACK_RPC_URL=https://api.mainnet-beta.solana.com

# PostgreSQL / Supabase Database Connection String (for async usage log flushing)
DATABASE_URL=postgres://postgres:password@db.your-supabase-project.supabase.co:5432/postgres

# Background Usage Log Flush Interval in Seconds
FLUSH_INTERVAL_SECONDS=10
